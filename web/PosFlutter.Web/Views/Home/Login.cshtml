@model PosFlutter.Web.Models.LoginForm
<section class="login"><h1>Ingresar al punto de venta</h1><p>Accede con las credenciales autorizadas en el servidor central.</p><form asp-action="Login" method="post"><div asp-validation-summary="All" class="error"></div><label>Identificador del negocio <input asp-for="BusinessGlobalId" required></label><label>Identificador del dispositivo enrolado <input asp-for="DeviceGlobalId" required></label><label>Usuario <input asp-for="Username" autocomplete="username" required></label><label>Contraseña <input asp-for="Password" type="password" autocomplete="current-password" required></label><button class="primary" type="submit">Iniciar sesión</button></form><p class="muted">El dispositivo debe existir y estar autorizado en la API central.</p></section>