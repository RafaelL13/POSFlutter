@{ ViewData["Title"]="Administración"; }
<section class="report-admin" aria-labelledby="report-title">
 <header><div><span class="eyebrow">ADMINISTRACIÓN FINANCIERA</span><h1 id="report-title">Reportes de operación</h1><p>Ventas confirmadas, costos FIFO históricos y cancelaciones separadas.</p></div><div class="report-actions"><button data-export="csv">CSV</button><button data-export="xlsx">Excel</button><button data-export="pdf">PDF</button></div></header>
 <form id="report-filters" class="report-filters" novalidate><label>Desde<input name="from" type="date" required></label><label>Hasta<input name="to" type="date" required></label><label>Sucursal<input name="branch" type="text" inputmode="text" placeholder="GUID autorizado"></label><label>Vendedor<input name="user" type="text" placeholder="GUID autorizado"></label><label>Producto<input name="product" type="text" placeholder="GUID de producto"></label><label>Pago<select name="payment"><option value="">Todos</option><option>Cash</option><option>Card</option><option>Transfer</option></select></label><label>Estado<select name="status"><option value="">Todos</option><option>Confirmed</option><option>Cancelled</option></select></label><label>Orden<select name="sort"><option value="date">Fecha</option><option value="total">Importe</option><option value="folio">Folio</option><option value="status">Estado</option></select></label><button type="submit">Aplicar filtros</button></form>
 <p id="report-status" role="status" aria-live="polite"></p><div id="report-summary" class="report-kpis"></div><section class="report-panel"><h2>Ventas</h2><div class="table-wrap"><table><thead><tr><th>Folio</th><th>Fecha</th><th>Vendedor</th><th>Pago</th><th>Estado</th><th>Unid.</th><th>Importe</th><th>Costo FIFO</th><th>Utilidad</th></tr></thead><tbody id="report-sales"></tbody></table></div><nav class="report-pages"><button id="report-prev">Anterior</button><span id="report-page"></span><button id="report-next">Siguiente</button></nav></section>
 <section class="report-panel"><h2>Inventario FIFO</h2><div class="table-wrap"><table><thead><tr><th>Producto</th><th>Existencia</th><th>Lotes</th><th>Valor FIFO</th></tr></thead><tbody id="report-inventory"></tbody></table></div></section>
</section>
<script src="~/js/admin-reports.js" asp-append-version="true"></script>
